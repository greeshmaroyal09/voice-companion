# Backend only. Copy to .env in the project root and set your own key.
GNANI_API_KEY=

# Optional natural Telugu / Telugu-English request interpretation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: only for an administrator-approved HTTPS inspection CA bundle.
# Use an absolute path to a PEM CA bundle. Never disable TLS verification.
# SSL_CERT_FILE=C:/certificates/approved-ca-bundle.pem
