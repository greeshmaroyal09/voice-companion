@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700&family=Noto+Sans+Telugu:wght@400;500;600&display=swap');

:root{font-family:'DM Sans',system-ui,sans-serif;color:#213c34;background:#f6f8f6;font-synthesis:none;font-weight:400;-webkit-font-smoothing:antialiased;font-optical-sizing:auto}
*{box-sizing:border-box}body{margin:0}button,a{-webkit-tap-highlight-color:transparent}button{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed}button:focus-visible,a:focus-visible{outline:3px solid #c48738;outline-offset:5px}button{touch-action:manipulation}a{color:inherit;text-decoration:none}.app-shell{max-width:1200px;margin:0 auto;padding:0 48px}.topbar{height:102px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #e2e8e2}.brand{display:flex;align-items:center;gap:10px;font-size:22px;font-weight:700;letter-spacing:-.9px}.brand-light{font-weight:450}.brand-icon{display:grid;place-items:center;width:38px;height:38px;background:#235c47;color:#fff;border-radius:12px}.phase-badge{display:flex;align-items:center;gap:9px;font-size:10px;font-weight:650;letter-spacing:1.3px;color:#6d7e74}.phase-badge>span:first-child{width:6px;height:6px;background:#73967d;border-radius:50%}.badge-divider{color:#bfc8bf;padding:0 3px}main{max-width:680px;margin:0 auto}.intro{text-align:center;padding:48px 0 29px}.eyebrow{font-size:10px;font-weight:700;letter-spacing:2px;color:#65806b;margin-bottom:16px}h1{font-size:34px;font-weight:550;line-height:1.25;letter-spacing:-1.4px;margin:0 0 14px}.intro>p{font-size:14px;line-height:1.8;color:#778278;margin:0}.mobile-break{display:none}.companion-card{background:#fff;border:1px solid #dee5dd;border-radius:22px;box-shadow:0 7px 28px #314b3410;overflow:hidden}.card-topline{display:flex;align-items:center;justify-content:space-between;padding:20px 25px}.session-label{display:flex;align-items:center;gap:8px;font-size:10px;font-weight:650;letter-spacing:1.3px;color:#748577}.live-dot{background:#769b70;width:6px;height:6px;border-radius:50%}.language-pill{display:flex;align-items:center;gap:7px;background:#f7f8f4;border:1px solid #e7eadd;padding:8px 10px;border-radius:8px;color:#536b53;font-size:12px}.language-pill [lang=te]{font-family:'Noto Sans Telugu',sans-serif;font-size:12px}.language-english{font-size:11px;color:#83907d;margin-left:1px}.record-area{display:flex;flex-direction:column;align-items:center;padding:14px 20px 27px}.status{font-size:12px;color:#839082;display:flex;align-items:center;gap:6px;min-height:18px}.status.is-recording{color:#b34f3d}.mic-orbit{margin:24px 0 20px;width:142px;height:142px;border:1px solid #eaf0e8;border-radius:50%;display:grid;place-items:center;background:#f7faf5;box-shadow:0 0 0 10px #fcfdfb}.record-button{width:114px;height:114px;border:0;border-radius:50%;background:#245f49;color:#fff;display:grid;place-items:center;box-shadow:0 5px 13px #235b4526;transition:background .2s,transform .2s}.record-button:hover:enabled{background:#174c39;transform:scale(1.03)}.record-button:disabled{background:#758e7d}.recording .record-button{background:#ae5343}.recording{box-shadow:0 0 0 10px #fdf5f1;animation:breathe 1.8s infinite}.record-area h2{font-size:18px;font-weight:550;letter-spacing:-.3px;margin:0 0 6px}.telugu-hint{font-family:'Noto Sans Telugu',sans-serif;font-size:13px;color:#859181;margin:0;line-height:1.8}.waveform{height:32px;display:flex;align-items:center;justify-content:center;gap:3px;margin:17px 0 6px}.waveform span{display:block;width:3px;max-height:32px;background:#cbdac4;border-radius:5px;transition:height .1s}.waveform.active span{background:#819a68}.record-limit{font-size:10px;color:#8a9487;letter-spacing:.2px;font-variant-numeric:tabular-nums}.conversation{padding:0 24px 20px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.text-panel{border:1px solid #e7eae3;border-radius:11px;padding:17px 17px 15px;min-width:0;min-height:176px}.transcript-panel{background:#fafbf9}.reply-panel{background:#f1f5ee;border-color:#e4ebdf}.panel-label{display:flex;align-items:center;justify-content:space-between;font-size:9px;color:#7d8979;font-weight:650;letter-spacing:1px;gap:6px}.panel-label>span:first-child{display:flex;align-items:center;gap:6px}.reply-panel .panel-label{color:#607459}.reply-tag{font-size:8px;letter-spacing:.7px;background:#e6eddf;border-radius:4px;padding:4px 5px}.placeholder{font-size:12px;line-height:1.85;color:#899183;margin:18px 0 10px}.placeholder span{font-size:10px;color:#9aa293}.telugu-copy{font-family:'Noto Sans Telugu',sans-serif;font-size:17px;line-height:1.9;overflow-wrap:anywhere;margin:16px 0 10px}.listen-button{display:flex;align-items:center;gap:7px;background:#fff;border:1px solid #d9e3d2;color:#44673b;border-radius:7px;padding:8px 10px;min-height:36px;font-size:10px;font-weight:550}.listen-button:hover:enabled{background:#e8f0e1}.listen-button:disabled{color:#a3af99;background:#ffffff80;border-color:#e1e8da}.card-footer{display:flex;align-items:center;justify-content:center;gap:7px;padding:13px;background:#fcfdfb;border-top:1px solid #edf0e9;color:#8c9785;font-size:10px}.try-note{display:flex;align-items:center;gap:13px;padding:20px 14px;color:#73816b}.try-icon{width:36px;height:36px;flex-shrink:0;display:grid;place-items:center;border:1px solid #dfe6d9;border-radius:50%}.try-note strong{font-size:11px;font-weight:550;color:#697962}.try-note p{font-size:11px;line-height:1.8;margin:3px 0 0}.try-note [lang=te]{font-family:'Noto Sans Telugu',sans-serif;color:#5d7352}.translation{color:#919b89;font-size:10px}.try-arrow{margin-left:auto;flex-shrink:0;color:#9baa91}.phase-note{font-size:12px;text-align:center;color:#697e60;margin:9px 0 35px}.phase-note span{display:block;font-size:10px;color:#9aa390;margin-top:8px;line-height:1.7}.page-footer{display:flex;justify-content:space-between;gap:16px;border-top:1px solid #e2e8df;padding:22px 0 28px;color:#95a08c;font-size:10px}.page-footer>span:first-child{font-size:8px;letter-spacing:1.5px;font-weight:600}.footer-dot{padding:0 7px}.setup-note,.error-note{margin:0 24px 10px;padding:12px;background:#fcf8ec;border:1px solid #ece1c6;border-radius:8px;display:flex;align-items:flex-start;gap:8px;color:#89733e;font-size:11px;line-height:1.7}.setup-note>svg,.error-note>svg{flex-shrink:0;margin-top:2px}.setup-note button{border:0;background:none;color:inherit;margin-left:auto;display:grid;place-items:center;min-width:24px;min-height:24px}.error-note{background:#fcf2ee;border-color:#eed8cf;color:#934c3d;margin-bottom:20px;font-size:12px}.error-note strong{font-weight:600}.error-note p{margin:3px 0 0}.spin{animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@keyframes breathe{50%{box-shadow:0 0 0 15px #fdf5f1}}
@media(min-width:1400px){.intro{padding-top:62px}.record-area{padding-top:22px;padding-bottom:32px}.mic-orbit{margin-top:27px;margin-bottom:23px}.page-footer{margin-top:25px}}
@media(max-width:650px){.app-shell{padding:0 20px}.topbar{height:78px}.brand{font-size:19px}.brand-icon{width:33px;height:33px;border-radius:10px}.phase-badge{font-size:8px;letter-spacing:.7px}.phase-badge .badge-divider,.phase-badge{gap:5px}.intro{padding:33px 0 25px}.eyebrow{font-size:8px;letter-spacing:1.6px;margin-bottom:14px}h1{font-size:29px;letter-spacing:-1px;line-height:1.3}.mobile-break{display:block}.intro>p{font-size:12px}.desktop-break{display:none}.companion-card{border-radius:18px}.card-topline{padding:17px 17px 13px}.session-label{font-size:8px;letter-spacing:1px}.language-pill{padding:7px 8px}.language-english{display:none}.record-area{padding-top:12px;padding-bottom:23px}.conversation{grid-template-columns:1fr;padding:0 16px 16px;gap:10px}.text-panel{min-height:115px;padding:15px}.reply-panel{min-height:160px}.placeholder{font-size:13px;margin:14px 0 5px}.placeholder span{font-size:11px}.panel-label{font-size:9px}.listen-button{font-size:12px;min-height:44px;padding:9px 12px;margin-top:15px}.telugu-copy{font-size:18px}.card-footer{padding:13px 8px;font-size:9px}.try-note{padding:18px 2px;gap:10px}.try-note p{font-size:11px}.translation{display:block;font-size:10px}.try-arrow{display:none}.phase-note{font-size:11px;margin:5px 0 24px}.phase-note span{font-size:9px;padding:0 10px}.page-footer{flex-direction:column;align-items:center;gap:10px;padding:21px 0}.setup-note,.error-note{margin-left:16px;margin-right:16px}.setup-note{font-size:10px}.mic-orbit{margin-top:20px}.record-limit{font-size:11px}}
@media(max-width:370px){.app-shell{padding:0 12px}.brand{font-size:17px}.phase-badge{font-size:7px}h1{font-size:27px}.language-pill{gap:5px}.session-label{font-size:7px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
.conversation-tools { display:flex; justify-content:space-between; align-items:center; gap:12px; padding:0 24px 12px; font-size:11px; color:#5c705f; }
.conversation-tools button { background:none; color:#245f49; border:1px solid #dce5d8; border-radius:7px; padding:8px; min-height:40px; }
.remembered { display:flex; gap:7px; flex-wrap:wrap; padding:0 24px 14px; font-size:12px; line-height:1.8; }
.remembered span { background:#f1f5ee; border-radius:6px; padding:4px 8px; overflow-wrap:anywhere; }
.remembered strong { text-transform:capitalize; }
.text-entry { padding:0 24px 20px; }
.text-entry label { display:block; font-size:12px; margin-bottom:8px; color:#596f5b; }
.text-entry>div { display:flex; gap:8px; }
.text-entry input { min-width:0; flex:1; font:inherit; font-size:14px; padding:10px; border:1px solid #d4dfcf; border-radius:8px; }
.text-entry button { border:0; background:#245f49; color:white; border-radius:8px; padding:10px 16px; min-height:44px; }
.text-entry button:disabled { opacity:.5; }
.conversation-history { padding:0 24px 20px; font-size:13px; line-height:1.9; overflow-wrap:anywhere; }
.conversation-history summary { cursor:pointer; color:#245f49; padding:8px 0; }
.conversation-history>div { border-top:1px solid #e5eadd; }
.privacy-note { padding:0 24px; font-size:15px; line-height:1.9; color:#475b4c; }
.conversation-actions { display:flex; flex-wrap:wrap; gap:8px; padding:20px 24px; }
.conversation-actions button,.preparation button { min-height:48px; padding:10px 14px; border:1px solid #9bb8aa; border-radius:10px; background:#fff; color:#245f49; font:inherit; font-size:16px; cursor:pointer; display:inline-flex; align-items:center; gap:8px; }
.conversation-actions button:disabled,.preparation button:disabled { opacity:.5; cursor:default; }
.preparation { margin:8px 24px 28px; padding:20px; border:1px solid #c9daca; background:#f7faf4; border-radius:16px; font-size:17px; line-height:1.9; overflow-wrap:anywhere; }
.preparation h2 { font-size:24px; }.preparation h3 { font-size:19px; margin:8px 0; }
.preparation .coverage { font-size:13px; color:#526353; }
.checklist-items article { border-top:1px solid #cedccd; padding:18px 0; }
.item-kind { font-size:14px; color:#526353; }.preparation summary { cursor:pointer; padding:12px 0; min-height:48px; }
.preparation details { font-size:15px; }.preparation a { color:#195d44; text-decoration:underline; }
.sample-paper { border:2px dashed #99896a; padding:18px; background:#fff9e8; }.sample-paper strong { color:#8a341b; }
.conversation-history { font-size:16px; }
button:focus-visible,summary:focus-visible,a:focus-visible { outline:3px solid #a75a16; outline-offset:3px; }
@media(max-width:650px) { .preparation { margin:8px 16px 20px; padding:14px; }.conversation-actions { padding:16px; } }
@media(max-width:650px) { .conversation-tools,.remembered { padding-left:16px; padding-right:16px; } .text-entry,.conversation-history { padding-left:16px; padding-right:16px; } }
