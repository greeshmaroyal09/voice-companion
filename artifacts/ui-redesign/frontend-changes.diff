+.conversation-empty { padding: 39px 28px 35px; text-align: center; }
+.welcome-mark { display: inline-grid; place-items: center; width: 65px; height: 65px; border: 1px solid #ece5f5; border-radius: 20px; color: #8262b6; background: linear-gradient(135deg, #f7f4fc, #eeebf8); box-shadow: 0 5px 18px #77609a09, inset 0 1px #fff; transform: rotate(-6deg); margin: 0 0 25px; }
+.welcome-mark svg { transform: rotate(6deg); }
+.conversation-empty .eyebrow { font-size: 8px; letter-spacing: 1.6px; margin-bottom: 13px; }
