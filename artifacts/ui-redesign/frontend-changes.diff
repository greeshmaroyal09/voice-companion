+.starter { min-width: 0; display: flex; align-items: flex-start; gap: 10px; text-align: left; border: 1px solid #e7e2ee; background: #fdfcfe; border-radius: 8px; padding: 15px 12px; color: #8a76a3; }
+.starter > span { min-width: 0; flex: 1; }
+.starter strong { font-size: 11px; font-weight: 550; color: #53465f; display: block; line-height: 1.5; }
+.starter small { font-size: 9px; color: #84778d; display: block; margin-top: 5px; line-height: 1.6; }
