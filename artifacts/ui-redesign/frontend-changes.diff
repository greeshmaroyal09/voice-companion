+.eyebrow, .session-note, .remembered-label, .message-meta, .message-meta > span,
+.conversation-beginning, .composer-mode, .composer-mode .keyboard-hint,
+.composer-help, .conversation-footnote, .page-footer, .coverage, .plan-empty > span,
+.item-kind, .starter small, .preparation details { color: #706078; }
+@keyframes spin { to { transform: rotate(360deg); } }
+@keyframes breathe { 50% { box-shadow: 0 0 0 10px #b988db0c, 0 0 25px #b988db14; } }
+@keyframes blink { 50% { opacity: .35; } }
+@keyframes message-in { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes audio-bars { to { transform: scaleY(.4); } }
