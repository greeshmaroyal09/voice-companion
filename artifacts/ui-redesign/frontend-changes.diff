+:root {
+  font-family: 'DM Sans', 'Noto Sans Telugu', system-ui, sans-serif;
+  color: #292634;
+  background: #f7f7fb;
+  font-synthesis: none;
+  font-weight: 400;
+  -webkit-font-smoothing: antialiased;
+  font-optical-sizing: auto;
+  --ink: #292634;
+  --muted: #706c7e;
+  --line: #e9e7ef;
+  --accent: #6351bb;
+  --accent-dark: #4e3d9e;
+  --gradient: linear-gradient(130deg, #7361c9, #5140a1 70%, #70519e);
+}
+* { box-sizing: border-box; }
+html { scroll-behavior: smooth; scroll-padding-top: 24px; }
+body { margin: 0; min-width: 320px; }
+button, textarea, input { font: inherit; }
+button, a, summary { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
+button, summary { cursor: pointer; }
+button { transition: background .18s, border-color .18s, box-shadow .18s, transform .18s; }
+button:disabled { cursor: not-allowed; }
+a { color: inherit; text-decoration: none; }
+button:focus-visible, a:focus-visible, summary:focus-visible, textarea:focus-visible { outline: 3px solid #9a79df; outline-offset: 4px; }
+svg { flex-shrink: 0; }
+p, h1, h2, h3, h4 { margin-top: 0; }
+button:disabled { opacity: .48; }
+[lang='te'] { font-family: 'Noto Sans Telugu', sans-serif; line-height: 1.95; }
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+.skip-link { position: fixed; left: 12px; top: -100px; padding: 14px; background: white; color: var(--accent-dark); z-index: 100; box-shadow: 0 4px 20px #211c3420; }
+.skip-link:focus { top: 12px; }
+.app-shell { display: grid; grid-template-columns: 218px minmax(0, 1fr); min-height: 100dvh; }
+.sidebar { position: sticky; top: 0; height: 100dvh; padding: 32px 20px 24px; background: #1c1b25; color: #d4d0df; display: flex; flex-direction: column; }
+.brand { display: flex; align-items: center; gap: 10px; font-size: 17px; font-weight: 650; letter-spacing: -.7px; color: #faf9ff; }
+.brand-icon { display: grid; place-items: center; width: 37px; height: 40px; border: 1px solid #ffffff26; border-radius: 11px; background: linear-gradient(145deg, #8c75ce, #63529c); box-shadow: inset 0 1px #ffffff2b; }
+.brand-light { font-weight: 400; }
+.brand small { display: block; font-size: 6.5px; letter-spacing: 1.8px; font-weight: 500; color: #b9b0c9; margin-top: 6px; }
+.sidebar-section { margin-top: 57px; }
+.nav-caption { display: block; font-size: 9px; letter-spacing: 1.8px; font-weight: 600; color: #9892a6; margin: 0 13px 15px; }
+.nav-item { display: flex; align-items: center; gap: 11px; min-height: 48px; padding: 12px; font-size: 12px; border-radius: 8px; margin-bottom: 7px; color: #b1aabd; transition: background .18s, color .18s; }
+.nav-item.selected { background: linear-gradient(110deg, #71608a3b, #63527d24); border: 1px solid #c2abe623; color: #efe8ff; }
+.nav-item:hover { background-color: #ffffff0b; color: #fff; }
+.nav-item > svg:last-child:not(:first-child), .nav-current { margin-left: auto; }
+.nav-current { width: 5px; height: 5px; background: #b69bff; border-radius: 50%; }
+.sidebar-bottom { margin-top: auto; padding: 46px 11px 0; }
+.sidebar-note-icon { color: #b3a1d8; display: block; margin-bottom: 18px; }
+.sidebar-note h2 { font-size: 17px; color: #e7e0f2; font-weight: 450; letter-spacing: -.3px; line-height: 1.6; margin-bottom: 12px; }
+.sidebar-note p { color: #b1a7c0; font-size: 11px; line-height: 1.9; margin-bottom: 16px; }
+.sidebar-language { font-size: 10px; color: #c4b8d6; }
+.sidebar-privacy { display: flex; align-items: center; gap: 7px; border-top: 1px solid #ffffff12; margin-top: 28px; padding-top: 23px; font-size: 10px; color: #bcb3cb; }
+.sidebar-privacy > svg:last-child { margin-left: auto; }
+.independent-note { display: block; color: #a69caf; font-size: 10px; line-height: 1.8; margin-top: 17px; }
+.workspace { min-width: 0; }
+.topbar { min-height: 83px; padding: 20px 37px; border-bottom: 1px solid var(--line); display: flex; align-items: center; justify-content: space-between; gap: 16px; background: #ffffff85; }
+.breadcrumb { display: flex; align-items: center; gap: 12px; color: #777181; font-size: 11px; }
+.breadcrumb strong { font-weight: 500; color: #4b4557; }
+.breadcrumb > span:not(.breadcrumb-icon) { color: #cbc5d3; }
+.breadcrumb-icon { display: grid; place-items: center; border: 1px solid var(--line); width: 29px; height: 29px; border-radius: 7px; background: white; color: #827493; }
+.new-conversation { min-height: 41px; border: 1px solid #ddd9e8; background: #fff; color: #575061; display: flex; align-items: center; gap: 7px; border-radius: 7px; padding: 9px 12px; font-size: 11px; box-shadow: 0 2px 3px #20133403; }
+.new-conversation:hover:enabled { background: #f0edf9; border-color: #a99acc; }
+.mobile-brand, .small-break { display: none; }
