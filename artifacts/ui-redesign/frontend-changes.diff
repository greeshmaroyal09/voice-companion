+.page-heading { display: flex; align-items: center; justify-content: space-between; gap: 22px; margin-bottom: 27px; }
+.eyebrow { font-size: 9px; font-weight: 650; letter-spacing: 1.6px; line-height: 1.5; color: #857d94; margin-bottom: 10px; }
+.page-heading .eyebrow { display: flex; align-items: center; gap: 7px; }
+.page-heading .eyebrow > span { width: 5px; height: 5px; border-radius: 50%; background: #9483ba; }
+h1 { font-size: clamp(27px, 2.35vw, 39px); font-weight: 500; letter-spacing: -1.4px; line-height: 1.35; margin: 0 0 9px; }
+h1 > span { color: #7961aa; background: linear-gradient(95deg, #6856ae, #a6729b); background-clip: text; -webkit-text-fill-color: transparent; }
+.page-description { color: var(--muted); font-size: 12px; line-height: 1.9; margin-bottom: 0; }
+.language-pill { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; padding: 7px 11px; background: #f1eef7; border: 1px solid #e6e0ef; border-radius: 6px; font-size: 10px; color: #6f5d85; }
+.language-pill [lang='te'] { font-size: 11px; }
+.language-divider { height: 12px; width: 1px; background: #d9cfe4; }
+.workspace-grid { display: grid; grid-template-columns: minmax(0, 1fr) 302px; gap: 24px; align-items: start; }
+.conversation-surface { min-width: 0; border: 1px solid #e4e0eb; border-radius: 13px; background: #fff; box-shadow: 0 6px 24px #28213a04; scroll-margin-top: 20px; }
+.conversation-heading { padding: 17px 24px; border-bottom: 1px solid #eeeaf3; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
+.conversation-heading > div { display: flex; align-items: center; gap: 10px; }
+.conversation-heading h2 { font-size: 13px; font-weight: 600; letter-spacing: -.2px; margin: 0; }
+.conversation-symbol { color: #8a7aab; display: flex; }
+.session-note { display: flex; align-items: center; gap: 6px; font-size: 9px; color: #7f788b; }
